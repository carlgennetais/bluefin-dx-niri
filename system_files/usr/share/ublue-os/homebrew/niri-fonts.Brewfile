# Nerd Fonts this image adds on top of Bluefin's own font list.
#
# Not named fonts.Brewfile: that path belongs to the base image
# (projectbluefin/common) and `ujust devmode` installs from it, so a file of the
# same name here would replace Bluefin's list instead of extending it.
# JetBrains Mono and Fira Code are already in Bluefin's list.

cask "font-meslo-lg-nerd-font"
cask "font-hack-nerd-font"
